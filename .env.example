# Optional — enables live Gemini scoring. Without this, Vouch uses local offline rules.
# Get a key at https://aistudio.google.com/apikey
# Never commit the real key. For Vercel, add the same name in Project → Settings → Environment Variables.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
